# Copy to .env and adjust. install.sh generates one for you with random secrets.

# Port the memory-vault HTTP API listens on (host side)
MV_PORT=8000

# Postgres password for the memory_vault role (containers only, not exposed beyond compose network + MV_DB_PORT)
MV_DB_PASSWORD=change-me

# Host port for Postgres (only needed if you want to psql from the host)
MV_DB_PORT=5432

# Bearer token the MCP shim uses to talk to the app.
# Created inside the app container: docker compose exec app python -m src.cli token create claude-shim
MV_TOKEN=

# Base URL the shim and scripts use to reach the app
MV_URL=http://localhost:8000
